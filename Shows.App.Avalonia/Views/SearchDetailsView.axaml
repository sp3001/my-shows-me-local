<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Shows.App.Avalonia.ViewModels"
             xmlns:local="using:Shows.App.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="Shows.App.Avalonia.Views.SearchDetailsView"
             x:DataType="vm:SearchDetailsViewModel">

    <!--
      Details for an untracked search result (user-issues 3 / improvement 10). The show has no
      tracked_show id yet, so this page reads the catalog record by TVmaze id and reuses ShowCardView —
      the same view the search list uses — so the Start / Later add buttons and the R3 title rule are not
      duplicated. The ContentControl bound to Card resolves to ShowCardView via the app-wide ViewLocator.

      The inset lives on the content as a Margin, NOT as ScrollViewer.Padding. Avalonia's ScrollViewer does
      not reliably include its own bottom padding in the scrollable extent, so the last element was cut off
      and the scrollbar mis-measured (same fix as the tracked-details page). As a content Margin it is part
      of the measured extent, so the page always scrolls fully into view.
    -->
    <ScrollViewer>
        <StackPanel Spacing="10" Margin="12">
            <ProgressBar IsIndeterminate="True" Height="6" HorizontalAlignment="Center" Width="120"
                         IsVisible="{Binding IsBusy}" />

            <TextBlock Text="{Binding StatusMessage}" IsVisible="{Binding IsEmpty}" Opacity="0.6" TextWrapping="Wrap" />

            <!-- The shared card carries the title, meta, network/country and the synopsis (DescriptionText),
                 so the overview is NOT repeated here (user-issues 19 follow-up: it was duplicated). -->
            <ContentControl Content="{Binding Card}" IsVisible="{Binding IsEmpty, Converter={StaticResource InvertBool}}" />

            <!-- External links built from ids at render (SPEC P5, improvement 20) — no URL column exists.
                 Same buttons as the tracked-details page; the IMDb one hides when the show has no tt id. -->
            <StackPanel Orientation="Horizontal" Spacing="12"
                        IsVisible="{Binding IsEmpty, Converter={StaticResource InvertBool}}">
                <Button Content="TVmaze" Command="{Binding OpenTvmazeLinkCommand}" Classes="secondary" />
                <Button Content="IMDb" Command="{Binding OpenImdbLinkCommand}" Classes="secondary"
                        IsVisible="{Binding HasImdbLink}" />
                <Button Content="Official site" Command="{Binding OpenOfficialSiteLinkCommand}" Classes="secondary"
                        IsVisible="{Binding HasOfficialSiteLink}" />
            </StackPanel>

            <!-- Episode list (user-issues 19 follow-up): read-only (an untracked show has no watch state).
                 Always fetched live for the full guide, for both Discovery and Search hits. -->
            <Border Classes="section" IsVisible="{Binding HasSeasons}">
                <ItemsControl ItemsSource="{Binding Seasons}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CatalogSeasonViewModel">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="sectionHeader" Text="{Binding Header}" Margin="0,4,0,2" />
                                <ItemsControl ItemsSource="{Binding Episodes}" Margin="6,0,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CatalogEpisodeViewModel">
                                            <!-- Same row shape as the tracked details grid: the S/E marker at
                                                 the TOP with the runtime under it in small grey type, the air
                                                 date and TVmaze's rating on the title line, the synopsis as a
                                                 second truncated line, and an info button (vertically centred)
                                                 that opens the still and the full synopsis. No watched date —
                                                 an untracked show has no watch state, and no toggle — the row
                                                 is read-only. Every optional part hides itself when the
                                                 provider has no value for it, so a bare episode stays bare. -->
                                            <Border Classes="row">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                    <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding NumberText}" FontWeight="Bold"
                                                                   FontSize="12" MinWidth="44" />
                                                        <TextBlock Text="{Binding RuntimeText}" FontSize="10"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   IsVisible="{Binding RuntimeText, Converter={StaticResource IsNotNull}}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="1">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Text="{Binding Title}" FontSize="13"
                                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Classes="chipDot" Text="·" FontSize="11"
                                                                       IsVisible="{Binding AirDateText, Converter={StaticResource IsNotNull}}" />
                                                            <TextBlock Text="{Binding AirDateText}" FontSize="11" Opacity="0.6"
                                                                       VerticalAlignment="Center"
                                                                       IsVisible="{Binding AirDateText, Converter={StaticResource IsNotNull}}" />
                                                            <Border Classes="chip" VerticalAlignment="Center"
                                                                    IsVisible="{Binding RatingText, Converter={StaticResource IsNotNull}}">
                                                                <TextBlock Classes="chip" Text="{Binding RatingText, StringFormat='★ {0}'}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding DescriptionText}" FontSize="11"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis" MaxLines="1"
                                                                   IsVisible="{Binding HasDescription}" />
                                                    </StackPanel>
                                                    <!-- Flyout goes through Button.Flyout, never as the button's
                                                         child: Flyout is not a Control, so as a child it would
                                                         become Button.Content (hiding the ⓘ glyph from the
                                                         Button.info style) and the popup would never open. -->
                                                    <Button Grid.Column="2" Classes="info"
                                                            VerticalAlignment="Center"
                                                            IsVisible="{Binding HasInfo}">
                                                        <Button.Flyout>
                                                            <Flyout Placement="Right">
                                                                <StackPanel Spacing="8" MaxWidth="360">
                                                                    <Image Width="320" Stretch="Uniform"
                                                                           IsVisible="{Binding HasImage}"
                                                                           local:ImageBehavior.Url="{Binding ImageUrl}" />
                                                                    <TextBlock Text="{Binding FullDescription}" FontSize="12"
                                                                               TextWrapping="Wrap"
                                                                               IsVisible="{Binding HasDescription}" />
                                                                </StackPanel>
                                                            </Flyout>
                                                        </Button.Flyout>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
