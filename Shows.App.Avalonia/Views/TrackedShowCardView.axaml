<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Shows.App.Avalonia.ViewModels"
             xmlns:local="using:Shows.App.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="Shows.App.Avalonia.Views.TrackedShowCardView"
             x:DataType="vm:TrackedShowCardViewModel">

    <!-- A tracked show in a category tab (SPEC F4): poster, title (R3), progress bar + count, the
         unwatched-specials / needs-review notes (R4), and the inline collapsible seasons. MAUI's
         BindableLayout maps to an ItemsControl; the nested episode rows are an ItemsControl inside each
         season. The title and pin are tappable TextBlocks (Avalonia has no TapGestureRecognizer — the
         code-behind wires PointerPressed to the commands). -->
    <Border Classes="card" Margin="0,0,0,10">
        <Grid ColumnDefinitions="60,*" ColumnSpacing="10">
            <Image Grid.Column="0"
                   local:ImageBehavior.Url="{Binding PosterUrl}"
                   IsVisible="{Binding HasPoster}"
                   Width="60" Height="86" Stretch="UniformToFill" VerticalAlignment="Top" />
            <Border Grid.Column="0" Classes="poster"
                    IsVisible="{Binding HasPoster, Converter={StaticResource InvertBool}}"
                    Width="60" Height="86" VerticalAlignment="Top" />

            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Top">
                <!-- Title + chips share one line (improvement 3, re-shaped by improvement 26). The title is
                     the tappable link to details (issue 8) and the pin toggle (improvement 18) sits at the
                     far right.

                     The title and the chips are siblings in a WrapPanel, so they read in order —
                     "Title · chips" — and the chips follow the title's own text width instead of being
                     pushed to the right edge of the card (user request: they were right-aligned). A
                     WrapPanel measures a wrapping TextBlock against the AVAILABLE width, so the title
                     returns the width of its longest line and the chips take the rest of that line; when
                     there is no rest, they wrap onto the next line rather than being clipped. The earlier
                     Grid "*,Auto" pinned the chips to the right; a plain horizontal StackPanel would
                     measure the title at its full single-line width and push the chips off-screen.

                     The chip run is: the user's own chips (status, their 1-10 rating), a dot, then the grey
                     catalog chips (country, TVmaze's rating). They live here rather than on the meta line
                     because a long genre list used to push the country and rating off a trimmed line (user
                     request). The dot and each chip carry their own IsVisible, so the line never opens or
                     closes with a separator — an invisible child measures to nothing and costs no spacing.

                     The pin stays in its own Auto column: it is an action, not content, and must not wrap
                     into the text flow. -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <WrapPanel Grid.Column="0" ItemSpacing="6" LineSpacing="2" VerticalAlignment="Center">
                        <TextBlock Classes="link" Text="{Binding PrimaryTitle}" FontSize="15"
                                   FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center"
                                   PointerPressed="OnOpenDetails" />
                        <TextBlock Classes="chipDot" Text="·" VerticalAlignment="Center"
                                   IsVisible="{Binding ShowTitleChipSeparator}" />
                        <Border Classes="chip" VerticalAlignment="Center"
                                IsVisible="{Binding StatusText, Converter={StaticResource IsNotNull}}">
                            <TextBlock Classes="chip" Text="{Binding StatusText}" />
                        </Border>
                        <!-- The user's own rating (1-10) as a highlighted chip, next to status. Hidden when unrated. -->
                        <Border Classes="chip rating" VerticalAlignment="Center" IsVisible="{Binding HasUserRating}">
                            <TextBlock Classes="chip rating" Text="{Binding UserRatingText, StringFormat='★ {0}'}" />
                        </Border>
                        <TextBlock Classes="chipDot" Text="·" VerticalAlignment="Center"
                                   IsVisible="{Binding ShowChipSeparator}" />
                        <Border Classes="chip" VerticalAlignment="Center"
                                IsVisible="{Binding CountryText, Converter={StaticResource IsNotNull}}">
                            <TextBlock Classes="chip" Text="{Binding CountryText}" />
                        </Border>
                        <Border Classes="chip" VerticalAlignment="Center"
                                IsVisible="{Binding RatingChipText, Converter={StaticResource IsNotNull}}">
                            <TextBlock Classes="chip" Text="{Binding RatingChipText}" />
                        </Border>
                    </WrapPanel>
                    <TextBlock Grid.Column="1" Text="{Binding PinText}" FontSize="12"
                               VerticalAlignment="Center" Padding="6,2" Cursor="Hand"
                               IsVisible="{Binding CanPin}"
                               Foreground="{DynamicResource AccentBrush}"
                               PointerPressed="OnTogglePin" />
                </Grid>
                <TextBlock Text="{Binding SecondaryTitle}" Classes="subtitle"
                           IsVisible="{Binding HasSecondaryTitle}" TextWrapping="Wrap" />
                <!-- Meta line (year · genres · ★rating), matching the discovery card. Status is not here —
                     it is the chip beside the title. One line, trimmed, so a long genre list stays compact. -->
                <TextBlock Text="{Binding MetaText}" Classes="subtitle"
                           IsVisible="{Binding HasMetaText}"
                           TextTrimming="CharacterEllipsis" MaxLines="1" />

                <ProgressBar Value="{Binding ProgressFraction}" Minimum="0" Maximum="1"
                             IsVisible="{Binding HasProgress}" />
                <TextBlock Text="{Binding EpisodesText}" Classes="subtitle" />

                <TextBlock Text="Some specials unwatched" FontSize="11"
                           IsVisible="{Binding ShowSpecialsNote}" Opacity="0.6" />
                <TextBlock Text="Needs review" FontSize="11"
                           IsVisible="{Binding ShowNeedsReview}"
                           Foreground="{DynamicResource AccentBrush}" />

                <ProgressBar IsIndeterminate="True" Height="6" Width="60" HorizontalAlignment="Left"
                             IsVisible="{Binding IsBusy}" />

                <!-- Seasons render directly (no card-level "Episodes" toggle). Each season is a collapsible
                     row: the header + chevron are tappable (ToggleCommand), and the episode rows show only
                     while expanded (IsExpanded). The expanded/collapsed state is persisted (R9). -->
                <!-- Season spacing (improvement 26): the tracker is a long scroll, so the gaps between a
                     season header and its episodes are kept near-zero — the header's own padding and the
                     chevron already separate the blocks visually. -->
                <ItemsControl ItemsSource="{Binding Seasons}" Margin="0,2,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SeasonGroupViewModel">
                            <StackPanel Spacing="0">
                                <!-- The whole header row is the expand/collapse target (not just the chevron):
                                     a wide hit area that is easy to hit and sits clear of the ScrollViewer's
                                     scrollbar on the right. The chevron is purely visual. -->
                                <Border Classes="row" Padding="6,2">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6"
                                          Background="Transparent"
                                          Cursor="Hand" PointerPressed="OnToggleSeason">
                                        <TextBlock Grid.Column="0" Text="{Binding Header}"
                                                   FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                                        <!-- "~3h 25m · N": how long the season takes, then how many episodes
                                             are listed. The total leads because it is the number the user
                                             scans for (user request). Both come from the same displayable set
                                             (unwatched, already aired), so the two describe the same episodes.
                                             The runtime is absent when TVmaze has none for that season, and the
                                             dot hides with it so the count never opens with a separator. -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RuntimeText}" FontSize="11" Opacity="0.6"
                                                       IsVisible="{Binding RuntimeText, Converter={StaticResource IsNotNull}}" />
                                            <TextBlock Classes="chipDot" Text="·" FontSize="11"
                                                       IsVisible="{Binding RuntimeText, Converter={StaticResource IsNotNull}}" />
                                            <TextBlock Text="{Binding CountText}" FontSize="11" Opacity="0.6" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Chevron}"
                                                   FontSize="14" VerticalAlignment="Center" Padding="10,3"
                                                   Margin="0,0,6,0"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                    </Grid>
                                </Border>
                                <ItemsControl ItemsSource="{Binding Episodes}" Margin="10,0,0,0"
                                              IsVisible="{Binding IsExpanded}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:EpisodeRowViewModel">
                                            <!-- The whole row is the watch toggle (MAUI's row tap gesture);
                                                 the checkbox is display-only (IsEnabled=False) and the
                                                 PointerPressed handler runs ToggleWatchedCommand. -->
                                            <Border Classes="row" Padding="6,1">
                                                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="6"
                                                      Background="Transparent" PointerPressed="OnToggleEpisode">
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsWatched}"
                                                              IsHitTestVisible="False"
                                                              VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding NumberText}" FontSize="11"
                                                               FontWeight="Bold" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding PrimaryTitle}" FontSize="11"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <!-- The episode's runtime sits at the right, just before the
                                                         air date (user request) — the row stays one line, and the
                                                         per-episode figure reads left-to-right into the season
                                                         header's total above it. Hidden when TVmaze has no runtime,
                                                         and the dot hides with it. -->
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding RuntimeText}" FontSize="11"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   IsVisible="{Binding RuntimeText, Converter={StaticResource IsNotNull}}" />
                                                        <TextBlock Classes="chipDot" Text="·" FontSize="11"
                                                                   IsVisible="{Binding RuntimeText, Converter={StaticResource IsNotNull}}" />
                                                        <TextBlock Text="{Binding AirDateText}" FontSize="11" Opacity="0.6" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
