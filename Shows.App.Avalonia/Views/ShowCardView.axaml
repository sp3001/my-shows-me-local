<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Shows.App.Avalonia.ViewModels"
             xmlns:local="using:Shows.App.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="Shows.App.Avalonia.Views.ShowCardView"
             x:DataType="vm:ShowCardViewModel">

    <!--
      The card shared by Search and Discovery — SPEC F3 names ShowCardViewModel as the shared unit. The
      add buttons (Start / Later) are always visible. MAUI's Border/StackLayout/Label map to Avalonia's
      Border/StackPanel/TextBlock; the poster loads through the ImageBehavior attached property (Avalonia
      Image.Source needs a bitmap, not a URL string).
    -->
    <Border Classes="card" Margin="0,0,0,10">
        <StackPanel Spacing="6">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Image Grid.Column="0" Classes="cardPoster"
                       Classes.large="{Binding LargePoster}"
                       local:ImageBehavior.Url="{Binding PosterUrl}"
                       IsVisible="{Binding HasPoster}"
                       Stretch="UniformToFill"
                       VerticalAlignment="Top" />
                <Border Grid.Column="0" Classes="poster cardPoster"
                        Classes.large="{Binding LargePoster}"
                        IsVisible="{Binding HasPoster, Converter={StaticResource InvertBool}}"
                        VerticalAlignment="Top" />

                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Top">
                    <!-- SPEC R3: localized primary, original beneath. The title is the tappable link to
                         details (tracked shows → tracked-details page, untracked → catalog page); on the
                         details page itself the card renders the title as plain text (ShowTitleLink). -->
                    <TextBlock Classes="link" Text="{Binding PrimaryTitle}" FontSize="16" FontWeight="Bold"
                               TextWrapping="Wrap" IsVisible="{Binding ShowTitleLink}"
                               PointerPressed="OnOpenDetails" />
                    <TextBlock Text="{Binding PrimaryTitle}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               IsVisible="{Binding ShowTitleLink, Converter={StaticResource InvertBool}}" />
                    <TextBlock Text="{Binding SecondaryTitle}" Classes="subtitle"
                               IsVisible="{Binding HasSecondaryTitle}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding MetaText}" Classes="subtitle"
                               IsVisible="{Binding HasMetaText}" />
                    <TextBlock Text="{Binding GenresText}" Classes="subtitle"
                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                    <TextBlock Text="{Binding NetworkText}" Classes="subtitle"
                               IsVisible="{Binding HasNetworkText}"
                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                    <!-- Next Episode (Discovery only — Search has no episode data, so the line is hidden). -->
                    <TextBlock Text="{Binding NextEpisodeText}" Classes="subtitle"
                               IsVisible="{Binding HasNextEpisodeText}"
                               Foreground="{DynamicResource AccentBrush}"
                               TextTrimming="CharacterEllipsis" MaxLines="1" Padding="8,8" />
                </StackPanel>
            </Grid>

            <!-- Synopsis (user-issues 19 follow-up): fills the card's empty space. Plain text (the mapper
                 strips the markup), capped to ~1000 chars by the view-model. Hidden when the show has none. -->
            <TextBlock Text="{Binding DescriptionText}" TextWrapping="Wrap" MaxLines="6"
                       TextTrimming="CharacterEllipsis" Opacity="0.85"
                       IsVisible="{Binding HasDescription}" />

            <!-- Add-to-category actions. Visible only while the show is not yet tracked; once added, the
                 "Already tracked" marker replaces them (SPEC F2). Details now opens from the title link. -->
            <StackPanel Orientation="Horizontal" Spacing="8"
                        IsVisible="{Binding IsAlreadyTracked, Converter={StaticResource InvertBool}}">
                <Button Content="Start" Command="{Binding AddToStartedCommand}"
                        IsVisible="{Binding CanAdd}" />
                <Button Content="Later" Command="{Binding AddToLaterCommand}"
                        Classes="secondary" IsVisible="{Binding CanAdd}" />
                <ProgressBar IsIndeterminate="True" Width="40" VerticalAlignment="Center"
                             IsVisible="{Binding IsBusy}" />
            </StackPanel>

            <TextBlock Text="Already tracked"
                       IsVisible="{Binding IsAlreadyTracked}"
                       Foreground="{DynamicResource AccentBrush}" />

            <TextBlock Text="{Binding StatusMessage}" Classes="subtitle" TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
