<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Shows.App.Avalonia.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="Shows.App.Avalonia.Views.UpdatesRowView"
             x:DataType="vm:UpdatesRowViewModel">

    <!-- One row in an Updates section (improvement 25): (show + optional status chip) (episode) (date). The
         four sections share this one row shape and differ only in which optional middle column they fill, so
         they all scan the same way and the date is always the right-hand column. The status chip reuses the
         .chip style the tracker cards use, so a status reads identically everywhere, and it sits in the
         title's own flow after a dot rather than in a column of its own (improvement 26) — same as every
         other list, where the chips follow the title instead of being pinned to the right edge. The show
         title stays clickable (hand cursor + tap) and is the larger, bolder part of the row; a thin
         underline beneath each row separates the repeated shows. No purple — primary text colour, neutral
         rule. -->
    <Border BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="0,0,0,1" Padding="0,4">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <WrapPanel Grid.Column="0" ItemSpacing="6" LineSpacing="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding ShowTitle}" Cursor="Hand"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                           TextWrapping="Wrap" PointerPressed="OnOpenDetails" />
                <TextBlock Classes="chipDot" Text="·" VerticalAlignment="Center" IsVisible="{Binding HasStatus}" />
                <Border Classes="chip" VerticalAlignment="Center" IsVisible="{Binding HasStatus}">
                    <TextBlock Classes="chip" Text="{Binding StatusText}" />
                </Border>
            </WrapPanel>
            <TextBlock Grid.Column="1" Text="{Binding EpisodeText}" FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" MaxWidth="320"
                       IsVisible="{Binding HasEpisode}" />
            <TextBlock Grid.Column="2" Text="{Binding DateText}" FontSize="13"
                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                       HorizontalAlignment="Right" />
        </Grid>
    </Border>
</UserControl>
