<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Shows.App.Avalonia.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="Shows.App.Avalonia.Views.SearchView"
             x:DataType="vm:SearchViewModel">

    <!-- Debounced catalog search (SPEC F2). The TextBox drives the debounce: TextChanged calls
         OnQueryTextChanged (the code-behind), and Enter runs SearchCommand. The results list reuses the
         shared ShowCardView via the app-wide ViewLocator. -->
    <Grid RowDefinitions="Auto,Auto,*">
        <TextBox Grid.Row="0" Watermark="Search shows…"
                 Text="{Binding Query}"
                 TextChanged="OnSearchTextChanged"
                 KeyDown="OnSearchKeyDown"
                 Margin="12,8" />

        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="6" Margin="12,4"
                     IsVisible="{Binding IsBusy}" />

        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Margin="12,4" Opacity="0.6"
                   IsVisible="{Binding IsBusy, Converter={StaticResource InvertBool}}" />

        <ListBox Grid.Row="2" ItemsSource="{Binding Results}" Margin="12,0"
                 Padding="0,0,10,0" Background="Transparent" BorderThickness="0">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ShowCardViewModel">
                    <ContentControl Content="{Binding}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
