<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ARCHITECTURE.md §6: Unit / Integration / Architecture / Golden. Packages arrive in step 0.6;
    step 0.1 only puts the project in the graph.

    NetArchTest.Rules enforces the layer bans (step 8.1) and Microsoft.EntityFrameworkCore.Sqlite is
    here for temp-database integration tests (step 1.1+). Both are test-only consumers, so referencing
    them here does not put EF or HTTP into Application.
  -->
  <PropertyGroup>
    <RootNamespace>Shows.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shows.Domain\Shows.Domain.csproj" />
    <ProjectReference Include="..\Shows.Application\Shows.Application.csproj" />
    <ProjectReference Include="..\Shows.Infrastructure\Shows.Infrastructure.csproj" />
  </ItemGroup>

</Project>
