<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ARCHITECTURE.md §3 Shows.Jobs.*: a thin Host.CreateApplicationBuilder shell, no business logic in
    Program.cs. Step 0.1 only puts the project in the graph. Step 0.7 owns OutputType, Program.cs and
    the Infrastructure reference together, since an Exe with no entry point does not build.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- AssemblyName drives log/<appname>.log via Assembly.GetName().Name (ARCHITECTURE.md §7): the
         spec names the file log/Import.log, so the assembly is "Import", not "Shows.Jobs.Import". -->
    <AssemblyName>Import</AssemblyName>
    <RootNamespace>Shows.Jobs.Import</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shows.Infrastructure\Shows.Infrastructure.csproj" />
  </ItemGroup>

</Project>